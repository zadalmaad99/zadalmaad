rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isSuperadmin() {
      return isSignedIn() && request.auth.token.email in ["mathelove2@gmail.com", "admin.zadalmaad@admin.com"];
    }
    // The owner account — full unsupervised control. The other superadmin
    // email is still "isSuperadmin" for read/role purposes, but its writes
    // to curriculum content are routed through /pendingChanges instead of
    // applying directly (enforced below, not just in client code).
    function isOwner() {
      return isSignedIn() && request.auth.token.email == "mathelove2@gmail.com";
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdminRole() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myRole() == "admin";
    }
    function isAdmin() {
      return isSuperadmin() || isAdminRole();
    }
    function isAuthorizedStudent() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function ownsDoc() {
      return isSuperadmin() ||
        (isAdminRole() && resource.data.adminId == request.auth.uid);
    }

    match /users/{uid} {
      allow read: if isAdmin() || request.auth.uid == uid;
      allow write: if isSuperadmin();
    }

    match /admins/{uid} {
      allow read: if isSuperadmin() || request.auth.uid == uid;
      allow write: if isSuperadmin();
    }

    match /students/{studentId} {
      allow read: if ownsDoc() ||
        (isAuthorizedStudent() && request.auth.uid == studentId);
      allow write: if isAdmin();
    }

    match /records/{recordId} {
      allow read: if ownsDoc() ||
        (isAuthorizedStudent() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if ownsDoc() ||
        (isAuthorizedStudent() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /hadithRecords/{recordId} {
      allow read: if ownsDoc() ||
        (isAuthorizedStudent() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /khatmat/{khatmId} {
      allow read: if ownsDoc() ||
        (isAuthorizedStudent() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /listeningProgress/{progressId} {
      allow read: if ownsDoc() ||
        (isAuthorizedStudent() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Public — the المنهج page (books, شرح, PDFs) is readable without login.
    // Direct writes are owner-only — the watched superadmin's edits go
    // through /pendingChanges and only ever land here once the owner
    // approves them (which is itself a write performed as the owner).
    match /curriculumAudio/{bookId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /curriculumOverrides/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /curriculumMeta/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Real approval queue: the watched superadmin (admin.zadalmaad@admin.com)
    // can only ever create an entry here, never write curriculum collections
    // directly (see above) — only the owner can approve (apply) or reject.
    match /pendingChanges/{changeId} {
      allow read: if isSignedIn() &&
        (isOwner() || request.auth.token.email == resource.data.actorEmail);
      allow create: if isSuperadmin() && request.resource.data.actorEmail == request.auth.token.email;
      allow update, delete: if isOwner();
    }

    // Per-user YouTube resume position — each signed-in user only ever
    // touches their own doc (uid baked into both the id and the data), but
    // the owner can also read every doc to see everyone's progress.
    match /videoProgress/{docId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.uid || isOwner());
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow update: if isSignedIn() && request.auth.uid == resource.data.uid && request.auth.uid == request.resource.data.uid;
      // The owner can reset a user's watch statistics from the admin panel.
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.uid || isOwner());
    }

    // Per-user PDF reading position — mirrors videoProgress above, so the
    // owner's admin panel can see reading progress too, not just YouTube.
    match /pdfProgress/{docId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.uid || isOwner());
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow update: if isSignedIn() && request.auth.uid == resource.data.uid && request.auth.uid == request.resource.data.uid;
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.uid || isOwner());
    }
  }
}
